generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  passwordHash       String?
  role               Role                @default(CUSTOMER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  vendor             Vendor?
  orders             Order[]
  verifiedOrders     Order[]             @relation("VerifiedOrders")
  reviews            Review[]
  wishlist           Wishlist[]
  inventoryMovements InventoryMovement[]
  reviewedVendors    Vendor[]            @relation("VendorReviews")
}

model Vendor {
  id                String             @id @default(cuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id])
  storeName         String
  slug              String             @unique
  description       String?
  logo              String?
  rating            Float              @default(0)
  status            VendorStatus       @default(PENDING)
  plan              Plan               @default(FREE)
  commission        Float              @default(15)
  contactPhone      String?
  pickupCity        String?
  pickupState       String?
  pickupPincode     String?
  pan               String?
  gstin             String?
  bankAccountHolder String?
  bankIfsc          String?
  bankAccountLast4  String?
  bankAccountCipher String?
  statusReason      String?
  reviewedAt        DateTime?
  reviewedById      String?
  reviewedBy        User?              @relation("VendorReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  products          Product[]
  orders            Order[]
  fulfillments      OrderFulfillment[]

  @@index([status])
}

model Product {
  id                String              @id @default(cuid())
  vendorId          String
  vendor            Vendor              @relation(fields: [vendorId], references: [id])
  name              String
  slug              String              @unique
  description       String?
  price             Float
  comparePrice      Float?
  stock             Int                 @default(0)
  sku               String?
  lowStockThreshold Int                 @default(5)
  images            String[]
  category          String
  rating            Float               @default(0)
  reviewCount       Int                 @default(0)
  fastDelivery      Boolean             @default(false)
  assured           Boolean             @default(false)
  countryOfOrigin   String?
  status            ProductStatus       @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  reviews           Review[]
  orderItems        OrderItem[]
  wishlists         Wishlist[]
  movements         InventoryMovement[]

  @@unique([vendorId, sku])
}

model Order {
  id              String              @id @default(cuid())
  orderNo         String              @unique
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  vendorId        String?
  vendor          Vendor?             @relation(fields: [vendorId], references: [id])
  total           Float
  status          OrderStatus         @default(PENDING_PAYMENT)
  paymentMethod   String              @default("UPI")
  paymentId       String?
  paymentStatus   PaymentStatus       @default(PENDING)
  upiTxnRef       String?             @unique
  paidAt          DateTime?
  verifiedById    String?
  verifiedBy      User?               @relation("VerifiedOrders", fields: [verifiedById], references: [id])
  shippingAddress Json
  cancelledAt     DateTime?
  cancelReason    String?
  refundMarkedAt  DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           OrderItem[]
  fulfillments    OrderFulfillment[]
  movements       InventoryMovement[]
  reviews         Review[]

  @@index([paymentStatus, status, createdAt])
}

model OrderFulfillment {
  id             String              @id @default(cuid())
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id])
  vendorId       String
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  status         FulfillmentStatus   @default(AWAITING_PAYMENT)
  trackingNumber String?
  packedAt       DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          OrderItem[]
  movements      InventoryMovement[]

  @@index([vendorId, status])
  @@index([orderId])
}

model OrderItem {
  id            String           @id @default(cuid())
  orderId       String
  order         Order            @relation(fields: [orderId], references: [id])
  fulfillmentId String
  fulfillment   OrderFulfillment @relation(fields: [fulfillmentId], references: [id])
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  quantity      Int
  price         Float
}

model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  product       Product               @relation(fields: [productId], references: [id])
  orderId       String?
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  fulfillmentId String?
  fulfillment   OrderFulfillment?     @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)
  type          InventoryMovementType
  quantity      Int
  balanceAfter  Int
  reason        String?
  createdById   String?
  createdBy     User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Integer 1-5, enforced by a CHECK constraint in the database.
  rating    Int
  comment   String?
  status    ReviewStatus @default(VISIBLE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([orderId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Plan {
  FREE
  BASIC
  PREMIUM
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  PAID
  REJECTED
}

enum FulfillmentStatus {
  AWAITING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryMovementType {
  RESERVE
  RELEASE
  ADJUST
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
}


model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
}
