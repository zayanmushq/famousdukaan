# FamousDukaan Environment Variables
# Copy this to .env.local and fill in your values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Prisma / PostgreSQL
# DATABASE_URL = transaction pooler (6543) with pgbouncer=true&connection_limit=1&sslmode=require
# DIRECT_URL   = session pooler (5432) with sslmode=require, used for migrations
# Use the prisma role: postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-N-REGION.pooler.supabase.com:PORT/postgres
DATABASE_URL=postgresql://prisma.project-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://prisma.project-ref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# One-time admin setup (do not commit values). Run: npm run set-admin
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=use-a-long-unique-password

# Public UPI payee ID (not a secret). Falls back to 9759586000@upi if unset.
# NEXT_PUBLIC_UPI_ID=9759586000@upi
