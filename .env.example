# FamousDukaan Environment Variables
# Copy this to .env.local and fill in your values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Prisma / PostgreSQL (required for real data, optional for the demo UI)
DATABASE_URL=postgresql://user:password@localhost:5432/famousdukaan
DIRECT_URL=postgresql://user:password@localhost:5432/famousdukaan
